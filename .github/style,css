body {
  margin: 0;
  font-family: 'Press Start 2P', cursive;
  background: linear-gradient(#5c94fc, #cce6ff);
  color: white;
  text-align: center;
}

header {
  background: black;
  padding: 15px;
  font-size: 12px;
}

.start {
  height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

button {
  background: yellow;
  border: 3px solid black;
  padding: 15px;
  cursor: pointer;
}